<odoo>
    <record id="view_as_order_done_wizard_form" model="ir.ui.view">
        <field name="name">as.order.done.wizard.form</field>
        <field name="model">as.order.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Order">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="close_comment"/>
                </group>
                <footer>
                    <button string="Done Order" type="object"
                            name="action_confirm_close" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
