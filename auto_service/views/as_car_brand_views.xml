<odoo>

    <record id="as_car_brand_tree" model="ir.ui.view">
        <field name="name">as.car.brand.tree ()</field>
        <field name="model">as.car.brand</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="model_ids"/>
            </tree>
        </field>
    </record>
    <record id="as_car_brand_form" model="ir.ui.view">
        <field name="name">as.car.brand.form ()</field>
        <field name="model">as.car.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_as_car_brand_window" model="ir.actions.act_window">
        <field name="name">Car Manufacture</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">as.car.brand</field>
        <field name="view_mode">tree,form</field>
    </record>



</odoo>
